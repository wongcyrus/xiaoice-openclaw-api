# Server Configuration
PORT=3002

# Xiaoice Client Authentication Configuration
# Requests must sign using this secret, and specify this access key
XIAOICE_ACCESS_KEY=test_access_key
XIAOICE_SECRET_KEY=test_secret_key

# OpenClaw Gateway Connection Configuration
OPENCLAW_WS_URL=ws://127.0.0.1:18789
OPENCLAW_TOKEN=your_openclaw_gateway_token_here

# Default Target Agent inside OpenClaw
# Used if the incoming request does not provide 'userParams'
DEFAULT_AGENT_ID=summer
